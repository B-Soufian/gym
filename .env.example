# ============================================
# Lakhlifi Gym v9.0 — Environment Variables
# ============================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymvision
DB_USER=gymvision_app
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Rate Limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- WhatsApp (optional) ---
WHATSAPP_MODE=manual
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=
